{
    "name": "mpluskassa/mplusqapi",
    "description": "PHP Client for the MplusKASSA SOAP API",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.3 || ^8.0",
        "brick/math": "^0.9 || ^0.10 || ^0.11 || ^0.12 || ^0.13 || ^0.14 || ^0.15 || ^0.16 || ^0.17 || ^0.18 || ^0.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.5 || ^13.3"
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests"
    },
    "autoload": {
        "classmap": [
            "src/MplusKASSA/MplusQapi/",
            "src/MplusKASSA/Wsdl2PhpGenerator/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
